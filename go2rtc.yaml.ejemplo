# Copia este archivo a C:\go2rtc\go2rtc.yaml y cambia TU_CONTRASEÑA
api:
  origin: "*"   # deja que camara.godsplan.site hable con go2rtc

streams:
  camara_cable: rtsp://admin:TU_CONTRASEÑA@192.168.100.4:554/stream1

# Para que funcione el boton de fotos (copia ffmpeg.exe junto a go2rtc.exe)
ffmpeg:
  bin: C:\camaras\ffmpeg.exe
